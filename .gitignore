# Data never enter git (raw NISAR, EGMS, Sentinel-1, intermediates). Only data/README.md and the small
# query lists in data/scenes/ are tracked.
data/*
!data/README.md
!data/scenes/

# Secrets
.env
.netrc
*.token

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Big or local files that must not slip in from anywhere
*.h5
*.nc
*.zip
*.npz

# Pytest
.pytest_cache/

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
